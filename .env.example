# Canonical public URL used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://mannabread.com

# GA4 measurement ID. Set this in Vercel Production to enable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required for website inquiry emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Manna Bakery <inquiries@mannabread.com>"
INQUIRY_TO_EMAIL=

# Optional spam protection for inquiry forms.
# Add both keys to activate Google reCAPTCHA v3 verification.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_MODE=enforce

# Required for live Toast menu + stock sync.
# Keep these server-side only. Never prefix them with NEXT_PUBLIC_.
TOAST_API_BASE_URL=https://ws-api.toasttab.com
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=86f5eab2-db5c-4ff2-aa1f-7a77d12dbf1e

# Rentals availability calendar (Teamup). Server-side only. Never prefix with NEXT_PUBLIC_.
# TEAMUP_CALENDAR_KEY should be a read-only sharing-link key.
# Which sub-calendars block which space (purple, green) lives in TEAMUP_SUBCALENDARS in lib/booking/config.ts.
# Without the two keys, local dev uses clearly labelled mock data and production shows a fallback message.
# BOOKING_CALENDAR_USE_MOCK=true forces mock data on a deployed preview. Never set it in production.
TEAMUP_API_KEY=
TEAMUP_CALENDAR_KEY=
BOOKING_CALENDAR_USE_MOCK=
